{
  "name": "elemental-chaos",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
